# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Tu WhatsApp con código de país, sin + ni espacios (Perú = 51)
NEXT_PUBLIC_WHATSAPP_NUMBER=51987654321

# Datos de Yape que verán los usuarios al pagar
NEXT_PUBLIC_YAPE_NUMBER=987654321
NEXT_PUBLIC_YAPE_NAME=Tu Nombre

# --- Verificación de celular por WhatsApp (ver CLAUDE.md) ---
# Número del chip de verificación, con 51 adelante, sin + ni espacios
NEXT_PUBLIC_VERIFY_WHATSAPP_NUMBER=51913880121
# SECRETOS (solo en Vercel, SIN "NEXT_PUBLIC"): nunca los subas a GitHub
WHATSAPP_VERIFY_TOKEN=una-palabra-larga-que-inventas
WHATSAPP_APP_SECRET=app-secret-de-tu-app-en-meta
SUPABASE_SERVICE_ROLE_KEY=secret-key-de-supabase
